# ECHO environment variable names only — never commit real values.
# Backend reads these (see backend/src/main/resources/application.properties);
# the frontend build reads VITE_API_BASE.

# JWT Configuration (Phase 7.1a)
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_KID=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_TTL=
JWT_REFRESH_TTL=

# Redis Configuration (optional today; future use)
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# CORS Configuration (comma-separated exact origins, no wildcard with credentials)
CORS_ALLOWED_ORIGINS=

# Database Configuration (Render: SPRING_DATASOURCE_URL is injected from the
# linked database via render.yaml; the other two are only fallbacks)
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
DB_POOL_MAX=

# Local-development defaults live in application.properties, not here
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# JVM options for the container (e.g. heap sizing on small instances)
JAVA_OPTS=

# Frontend (Vercel -> Environment Variables). Must be the Render backend origin
# plus /api, e.g. https://echo-backend.onrender.com/api
VITE_API_BASE=
